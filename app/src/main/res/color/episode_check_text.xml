<?xml version="1.0" encoding="utf-8"?>
<!-- Check glyph flips to the dark on-primary tone inside the green-filled
     checked circle; grey on the hollow unfocused one. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="@color/text_on_primary" />
    <item android:color="@color/text_secondary" />
</selector>
