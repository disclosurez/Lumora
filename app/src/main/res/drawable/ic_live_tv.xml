<?xml version="1.0" encoding="utf-8"?>
<!-- Broadcast-cone "live signal" mark: a filled dot at bottom-centre with three arcs
     radiating up-left / up / up-right, concentric on the dot. Replaces the old
     corner-brackets + centre-dot reticle, which read as a camera/aiming icon rather than
     TV. Same stroke language as the rest of the tab icons (1.8dp, round caps/joins);
     the colour is tinted at usage sites. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFF1F5F9"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7.67,14A5,5 0 0 1 16.33,14M4.64,12.25A8.5,8.5 0 0 1 19.36,12.25M2.04,10.75A11.5,11.5 0 0 1 21.96,10.75" />
    <path
        android:fillColor="#FFF1F5F9"
        android:pathData="M12,14.5A2,2 0 1 1 12,18.5A2,2 0 1 1 12,14.5Z" />
</vector>
