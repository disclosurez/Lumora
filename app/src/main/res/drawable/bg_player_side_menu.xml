<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- surface_elevated at ~90% opacity - the video playing underneath stays visible
         through the drawer. Rounded RIGHT corners only; elevation/outlineProvider on the
         panel (activity_main.xml) still casts the drop shadow. -->
    <solid android:color="#E61C2230" />
    <corners
        android:topRightRadius="20dp"
        android:bottomRightRadius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/color_border" />
</shape>
