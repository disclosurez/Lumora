<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome toolbar version of the app mark (TV set + antenna + play), redrawn from the
     launcher foreground into the toolbar's icon language: 24dp viewport, 1.8dp stroke,
     round caps/joins, single tint colour. Using the adaptive launcher icon here would drop
     a flat #1A73E8 blue square onto the dark toolbar; this keeps the brand glyph crisp at
     40dp and consistent with the neighbouring ic_search/ic_settings/ic_refresh marks. All
     geometry clears the viewport edges by >=1.8dp even with the stroke applied, so nothing
     clips. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- TV body: rounded rect; antenna; two stand bars -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFF1F5F9"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,9.25 A2,2 0 0 1 5,7.25 H19 A2,2 0 0 1 21,9.25 V16.75 A2,2 0 0 1 19,18.75 H5 A2,2 0 0 1 3,16.75 Z M12,2.75 L7.5,7.25 M12,2.75 L16.5,7.25 M7.5,19.75 H16.5 M9.5,21 H14.5" />
    <!-- Play triangle, filled so it stays solid at toolbar size -->
    <path
        android:fillColor="#FFF1F5F9"
        android:pathData="M9,10.75 L16,13 L9,15.25 Z" />
</vector>
