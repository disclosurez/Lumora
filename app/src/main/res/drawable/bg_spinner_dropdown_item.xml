<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Spinner's dropdown popup is a plain (non-choice-mode) ListView - it doesn't mark
         the previously-chosen value with state_activated at all. What actually changes as
         you move through it (D-pad or touch) is state_selected, which AbsListView drives
         for both the touch/scroll position and the keyboard/remote navigation cursor. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <stroke android:width="2dp" android:color="@color/focus" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_muted" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
        </shape>
    </item>
</selector>
