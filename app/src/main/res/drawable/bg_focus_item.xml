<?xml version="1.0" encoding="utf-8"?>
<!-- Was a plain shape with a permanent stroke, so a focused button looked identical to an
     unfocused one - no highlight. Now a selector: filled + primary stroke on focus, muted
     and thin-outlined otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <stroke android:width="3dp" android:color="@color/primary" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_muted" />
            <stroke android:width="1dp" android:color="@color/outline" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
