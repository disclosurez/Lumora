<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/brand_muted" />
                    <stroke android:width="1dp" android:color="@color/color_border" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:gravity="left|fill_vertical" android:width="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="0"
                        android:startColor="@color/accent_gradient_start"
                        android:endColor="@color/accent_gradient_end" />
                    <corners
                        android:topLeftRadius="14dp"
                        android:bottomLeftRadius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <stroke android:width="1dp" android:color="@color/color_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/color_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
