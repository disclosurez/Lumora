<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected + Focused: brand fill + focus border -->
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <stroke android:width="2dp" android:color="@color/focus" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Selected only: solid brand fill, pill reads as "the active season" -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Focused only: outline picks up the focus ring -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <stroke android:width="2dp" android:color="@color/focus" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Default: subtle outline pill, not the sidebar's rectangular list-item look -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
            <stroke android:width="1dp" android:color="@color/color_border" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
