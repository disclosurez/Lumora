<?xml version="1.0" encoding="utf-8"?>
<!-- Re-expand affordance for a collapsed category rail. Unlike bg_toolbar_button (transparent
     until focused/pressed), this one is filled and outlined in every state: the button floats
     over the content list with nothing around it to read as chrome, so an unfilled version
     looks like decoration rather than a control and users miss it entirely. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <stroke android:width="2dp" android:color="@color/focus" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_accent" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
