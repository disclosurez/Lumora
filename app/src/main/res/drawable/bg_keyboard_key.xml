<?xml version="1.0" encoding="utf-8"?>
<!-- Matches bg_channel_row's focused treatment (fill + focus stroke) rather than a solid
     primary fill, which would put light-blue behind text_primary. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <stroke android:width="2dp" android:color="@color/focus" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
            <stroke android:width="1dp" android:color="@color/color_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
