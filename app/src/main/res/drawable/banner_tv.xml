<?xml version="1.0" encoding="utf-8"?>
<!-- Fire TV / Android TV home screen tile (320x180dp). Without an explicit
     android:banner on <application>, the TV launcher shows a blank tile instead
     of falling back to the regular mipmap launcher icon used on phones. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
