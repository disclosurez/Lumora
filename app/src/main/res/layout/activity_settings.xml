<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="horizontal">

    <!-- Nav rail -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:background="@color/canvas_elevated"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="16dp"
            android:text="Settings"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout android:id="@+id/navProviders" style="@style/Widget.Lumora.SettingsNavRow" android:tag="0">
            <TextView style="@style/Widget.Lumora.SettingsNavIcon" android:text="P" android:backgroundTint="@color/channel_1" />
            <TextView style="@style/Widget.Lumora.SettingsNavLabel" android:text="Providers" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navPlayback" style="@style/Widget.Lumora.SettingsNavRow" android:tag="1">
            <TextView style="@style/Widget.Lumora.SettingsNavIcon" android:text="D" android:backgroundTint="@color/channel_6" />
            <TextView style="@style/Widget.Lumora.SettingsNavLabel" android:text="Playback" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navFilters" style="@style/Widget.Lumora.SettingsNavRow" android:tag="2">
            <TextView style="@style/Widget.Lumora.SettingsNavIcon" android:text="F" android:backgroundTint="@color/channel_4" />
            <TextView style="@style/Widget.Lumora.SettingsNavLabel" android:text="Filters" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navPrivacy" style="@style/Widget.Lumora.SettingsNavRow" android:tag="3">
            <TextView style="@style/Widget.Lumora.SettingsNavIcon" android:text="V" android:backgroundTint="@color/channel_5" />
            <TextView style="@style/Widget.Lumora.SettingsNavLabel" android:text="Privacy" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navBackup" style="@style/Widget.Lumora.SettingsNavRow" android:tag="4">
            <TextView style="@style/Widget.Lumora.SettingsNavIcon" android:text="B" android:backgroundTint="@color/channel_3" />
            <TextView style="@style/Widget.Lumora.SettingsNavLabel" android:text="Backup &amp; Restore" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navEpg" style="@style/Widget.Lumora.SettingsNavRow" android:tag="5">
            <TextView style="@style/Widget.Lumora.SettingsNavIcon" android:text="E" android:backgroundTint="@color/channel_2" />
            <TextView style="@style/Widget.Lumora.SettingsNavLabel" android:text="EPG Sources" />
        </LinearLayout>

    </LinearLayout>

    <!-- Thin vertical divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider" />

    <!-- Content pane -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Pane: Providers -->
            <LinearLayout
                android:id="@+id/paneProviders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IPTV Provider"
                    style="@style/TextAppearance.Lumora.SettingsTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-12dp"
                    android:text="Select provider type, scan QR with phone, or enter manually"
                    style="@style/TextAppearance.Lumora.SettingsSubtitle" />

                <!-- Provider Type Selector -->
                <Spinner
                    android:id="@+id/settingsProviderTypeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_dropdown_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="40dp"
                    android:spinnerMode="dropdown" />

                <LinearLayout
                    android:id="@+id/settingsShowQrButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show phone QR pairing code"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- QR Code Section -->
                <LinearLayout
                    android:id="@+id/settingsQrSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/settingsQrStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <FrameLayout
                        android:id="@+id/settingsQrFrame"
                        android:layout_width="240dp"
                        android:layout_height="240dp"
                        android:layout_marginTop="12dp"
                        android:background="@android:color/white"
                        android:padding="10dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/settingsQrImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/settingsQrTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Divider: OR enter manually -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/divider" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:text="OR enter manually"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/divider" />
                </LinearLayout>

                <!-- M3U Fields -->
                <LinearLayout
                    android:id="@+id/settingsM3uGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/m3u_url" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText
                        android:id="@+id/settingsM3uUrl"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="@string/m3u_url_hint"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/user_agent" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText
                        android:id="@+id/settingsUserAgent"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="@string/user_agent_hint"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Xtream Fields -->
                <LinearLayout
                    android:id="@+id/settingsXtreamGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Server URL" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText
                        android:id="@+id/settingsXtreamUrl"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="http://example.com:8080"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Username" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText
                        android:id="@+id/settingsXtreamUser"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="Username"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Password" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText
                        android:id="@+id/settingsXtreamPass"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="Password"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/settingsSubscriptionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Stalker Fields -->
                <LinearLayout
                    android:id="@+id/settingsStalkerGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Server URL" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText
                        android:id="@+id/settingsStalkerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="http://example.com:8080"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/stalker_mac" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText
                        android:id="@+id/settingsStalkerMac"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="@string/stalker_mac_hint"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/stalker_serial" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText
                        android:id="@+id/settingsStalkerSerial"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="Default: 000000000000"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Jellyfin Fields -->
                <LinearLayout
                    android:id="@+id/settingsJellyfinGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Server URL" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText
                        android:id="@+id/settingsJellyfinUrl"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="http://192.168.1.100:8096"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Username" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText
                        android:id="@+id/settingsJellyfinUser"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="Jellyfin username"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Password" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <EditText
                        android:id="@+id/settingsJellyfinPass"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:hint="Password"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pane: Playback -->
            <LinearLayout
                android:id="@+id/panePlayback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Playback" style="@style/TextAppearance.Lumora.SettingsTitle" />

                <LinearLayout
                    android:id="@+id/settingsRecordingStorage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/recording_storage" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settingsDecoderMode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Playback settings" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pane: Filters -->
            <LinearLayout
                android:id="@+id/paneFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Filters" style="@style/TextAppearance.Lumora.SettingsTitle" />

                <CheckBox
                    android:id="@+id/settingsHideNonEnglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Hide non-English movies/series"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Pane: Privacy -->
            <LinearLayout
                android:id="@+id/panePrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Privacy" style="@style/TextAppearance.Lumora.SettingsTitle" />

                <CheckBox
                    android:id="@+id/settingsHideAdult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Hide adult categories"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/settingsParentalPin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale">
                    <TextView android:id="@+id/settingsParentalPinLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Set parental PIN" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settingsClearHistory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear watch history" android:textColor="@color/live_red" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pane: Backup & Restore -->
            <LinearLayout
                android:id="@+id/paneBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Backup &amp; Restore" style="@style/TextAppearance.Lumora.SettingsTitle" />

                <LinearLayout
                    android:id="@+id/settingsExportBackup"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/export_backup" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settingsImportBackup"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/import_backup" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pane: EPG Sources -->
            <LinearLayout
                android:id="@+id/paneEpg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EPG Sources" style="@style/TextAppearance.Lumora.SettingsTitle" />

                <LinearLayout
                    android:id="@+id/settingsAddEpgSource"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/card_surface_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:stateListAnimator="@animator/focus_scale">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_epg_source" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </ScrollView>

</LinearLayout>
