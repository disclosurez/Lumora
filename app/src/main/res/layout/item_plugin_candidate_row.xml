<?xml version="1.0" encoding="utf-8"?>
<!-- One provider a plugin proposed. Nothing is configured until "Add" is pressed and the
     confirmation accepted - see renderPluginPane() in MainActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_category_panel"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/settings_gap">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/candidateName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/settings_text_body"
                android:fontFamily="@font/inter_medium" />

            <TextView
                android:id="@+id/candidateVerified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/settings_gap_s"
                android:background="@drawable/pill_number"
                android:paddingHorizontal="8dp"
                android:text="@string/tested"
                android:textColor="@color/success_green"
                android:textSize="@dimen/settings_text_micro"
                android:fontFamily="@font/inter_semibold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/candidateDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/inter_regular"
            android:textSize="@dimen/settings_text_caption" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/candidateAddButton"
        style="@style/Widget.Lumora.PrimaryButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/settings_action_button_height"
        android:layout_marginStart="@dimen/settings_gap_s"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="@dimen/settings_gap"
        android:stateListAnimator="@animator/focus_scale">
        <TextView
            android:id="@+id/candidateAddLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/settings_text_body"
            android:fontFamily="@font/inter_semibold" />
    </LinearLayout>
</LinearLayout>
