<?xml version="1.0" encoding="utf-8"?>
<!-- The row itself is the enable/disable control: the checkbox is display-only (a bare
     CheckBox is a poor D-pad target, and a focusable one competes with Edit/Remove), so
     the root carries the focus and the click that flips it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_category_panel"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:nextFocusRight="@+id/rowEditButton"
    android:orientation="horizontal"
    android:padding="@dimen/settings_gap"
    android:stateListAnimator="@animator/focus_scale">

    <CheckBox
        android:id="@+id/rowEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/settings_gap"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/settings_text_body"
            android:fontFamily="@font/inter_medium" />

        <TextView
            android:id="@+id/rowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/inter_regular"
            android:textSize="@dimen/settings_text_caption" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowEditButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/settings_action_button_height"
        android:layout_marginStart="@dimen/settings_gap_s"
        android:background="@drawable/card_surface_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusLeft="@+id/rowRoot"
        android:nextFocusRight="@+id/rowRemoveButton"
        android:paddingHorizontal="@dimen/settings_gap"
        android:stateListAnimator="@animator/focus_scale">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/settings_text_caption"
            android:fontFamily="@font/inter_medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowRemoveButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/settings_action_button_height"
        android:layout_marginStart="@dimen/settings_gap_s"
        android:background="@drawable/card_surface_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusLeft="@+id/rowEditButton"
        android:paddingHorizontal="@dimen/settings_gap"
        android:stateListAnimator="@animator/focus_scale">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove"
            android:textColor="@color/live_red"
            android:textSize="@dimen/settings_text_caption"
            android:fontFamily="@font/inter_medium" />
    </LinearLayout>
</LinearLayout>
