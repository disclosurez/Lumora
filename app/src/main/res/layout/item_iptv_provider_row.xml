<?xml version="1.0" encoding="utf-8"?>
<!-- The row itself is the enable/disable control: the checkbox is display-only (a bare
     CheckBox is a poor D-pad target, and a focusable one competes with Edit/Remove), so
     the root carries the focus and the click that flips it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_category_panel"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:nextFocusRight="@+id/rowEditButton"
    android:orientation="horizontal"
    android:padding="12dp"
    android:stateListAnimator="@animator/focus_scale">

    <CheckBox
        android:id="@+id/rowEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowEditButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/card_surface_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusLeft="@+id/rowRoot"
        android:nextFocusRight="@+id/rowRemoveButton"
        android:paddingHorizontal="12dp"
        android:stateListAnimator="@animator/focus_scale">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowRemoveButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/card_surface_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusLeft="@+id/rowEditButton"
        android:paddingHorizontal="12dp"
        android:stateListAnimator="@animator/focus_scale">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove"
            android:textColor="@color/live_red"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
