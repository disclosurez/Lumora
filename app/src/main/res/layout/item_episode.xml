<?xml version="1.0" encoding="utf-8"?>
<!-- clipChildren/clipToPadding false: this row and episodeDownloadButton both scale to
     1.06x on focus - without this the scale-up gets clipped by this row's own bounds
     (episodeDownloadButton hugs the right edge) and by the RecyclerView hosting it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_channel_row"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:padding="8dp"
    android:stateListAnimator="@animator/focus_scale">

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_rounded_poster"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/episodeThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_play_circle_overlay"
            android:padding="6dp"
            android:src="@drawable/ic_play"
            android:tint="@android:color/white" />
    </FrameLayout>

    <TextView
        android:id="@+id/episodeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />

    <ImageButton
        android:id="@+id/episodeDownloadButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_toolbar_button"
        android:clickable="true"
        android:contentDescription="Download episode"
        android:focusable="true"
        android:padding="8dp"
        android:src="@android:drawable/stat_sys_download"
        android:stateListAnimator="@animator/focus_scale"
        android:tint="@color/text_secondary"
        android:visibility="gone" />
</LinearLayout>
