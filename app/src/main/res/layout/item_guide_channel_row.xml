<?xml version="1.0" encoding="utf-8"?>
<!-- clipChildren/clipToPadding false: guideChannelInfo and each guideProgramRow cell are
     height=match_parent and scale to 1.06x on focus (focus_scale/focus_scale_flat) - without
     this the scale-up overflows this row's own wrap_content bounds and gets clipped top+
     bottom, making the focus highlight look cut off / cropped. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/guideChannelInfo"
        android:layout_width="@dimen/guide_channel_column_width"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_channel_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/guide_row_min_height"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="6dp"
        android:paddingVertical="4dp"
        android:stateListAnimator="@animator/focus_scale">

        <!-- Hidden (not just blank) by the adapter when the channel has no number: at
             wrap_content with a minWidth it still reserved its column on every row, so a
             catalog with no tvg-chno at all indented every logo by a strip of empty space
             that looked like padding. -->
        <TextView
            android:id="@+id/guideChannelNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/guide_channel_number_text" />

        <FrameLayout
            android:layout_width="@dimen/guide_channel_logo_size"
            android:layout_height="@dimen/guide_channel_logo_size"
            android:background="@drawable/shape_logo_box">

            <TextView
                android:id="@+id/guideChannelInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/guide_channel_initial_text"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/guideChannelLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Name + one "now playing" line, stacked, so the channel column reads the same
             TiviMate way: number/logo, channel name, then what's airing. The now line is
             filled from the already-fetched EPG by LiveGuideAdapter (rows without EPG keep
             it empty/gone). It must stay non-focusable/non-clickable - guideChannelInfo
             remains the D-pad target. Sized to guide_channel_number_text (the guide's small
             secondary token) so name+now+padding still fit inside guide_row_min_height:
             the row never grows taller than it was with just the name. -->
        <LinearLayout
            android:id="@+id/guideChannelTextCol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/guideChannelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/guide_channel_name_text" />

            <TextView
                android:id="@+id/guideChannelNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/guide_channel_number_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- This wrapper must keep clipChildren at its default (true): a scrolled
         HorizontalScrollView's content is only clipped to its viewport by its *parent's*
         clipChildren, and the row root above disables that for focus-scale overflow.
         Without this layer, horizontally-scrolled program blocks draw straight over the
         channel-name column to the left. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <HorizontalScrollView
            android:id="@+id/guideProgramScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="18dp">

            <LinearLayout
                android:id="@+id/guideProgramRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </FrameLayout>
</LinearLayout>
