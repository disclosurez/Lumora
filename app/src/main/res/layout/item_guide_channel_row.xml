<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/guideChannelInfo"
        android:layout_width="@dimen/guide_channel_column_width"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_channel_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="42dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp"
        android:stateListAnimator="@animator/focus_scale">

        <TextView
            android:id="@+id/guideChannelNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="10dp"
            android:gravity="center"
            android:textColor="@color/text_tertiary"
            android:textSize="8sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/shape_logo_box">

            <TextView
                android:id="@+id/guideChannelInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/guideChannelLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/guideChannelName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/guideProgramScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/guideProgramRow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
