<?xml version="1.0" encoding="utf-8"?>
<!-- One installed plugin in Settings > Plugins: a navigation entry, nothing more. Selecting it
     opens panePluginDetail, which is where the plugin is enabled, updated, run and removed.
     Everything used to be crammed into this row - a discovery run's candidate list is a
     screenful on its own and had no room inside a row in a list of rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pluginRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/settings_gap_s"
    android:background="@drawable/bg_category_panel"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/settings_gap"
    android:stateListAnimator="@animator/focus_scale">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pluginName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/settings_text_body"
            android:textStyle="bold" />

        <!-- On/off, and what this plugin's last run came to if it was the one that ran. -->
        <TextView
            android:id="@+id/pluginSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/settings_text_caption" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_gap_s"
        android:text="›"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/settings_text_body" />
</LinearLayout>
