<?xml version="1.0" encoding="utf-8"?>
<!-- Season chip cell: the label keeps all the chip chrome (bg_season_chip, focus
     scale, selected state) and its click selects the season - unchanged. The check
     is a sibling appended to the right of the label: its click toggles watched/
     unwatched for the whole season. The container itself is not focusable - both
     children are their own D-pad targets, and LEFT/RIGHT between them is wired via
     OnKeyListener in MainActivity (default focus search won't cross a focusable
     child at the chip's edge). clipChildren/clipToPadding false on the cell so the
     label's 1.06x focus scale isn't sliced by the cell's own bounds; the
     HorizontalScrollView hosting the row already sets the same. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/seasonChipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_season_chip"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:fontFamily="@font/inter_medium"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:stateListAnimator="@animator/focus_scale"
        android:textColor="@color/season_chip_text"
        android:textSize="@dimen/text_body_l" />

    <!-- Green-filled when every episode in the season is watched, hollow outline
         otherwise. Shared drawable/color with the episode-row check so both read as
         the same "mark watched" control. -->
    <TextView
        android:id="@+id/seasonCheckButton"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_episode_check"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:stateListAnimator="@animator/focus_scale_flat"
        android:text="✓"
        android:textColor="@color/episode_check_text"
        android:textSize="@dimen/text_body" />
</LinearLayout>
