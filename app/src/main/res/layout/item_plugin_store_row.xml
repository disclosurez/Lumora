<?xml version="1.0" encoding="utf-8"?>
<!-- One plugin store in Settings > Plugins > Plugin Stores. Same shape as item_plugin_row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_category_panel"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/settings_gap">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/storeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/settings_text_body"
            android:fontFamily="@font/inter_medium" />

        <TextView
            android:id="@+id/storeUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/inter_regular"
            android:textSize="@dimen/settings_text_caption" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/storeBrowseButton"
        style="@style/Widget.Lumora.SecondaryButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/settings_action_button_height"
        android:layout_marginStart="@dimen/settings_gap_s"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="@dimen/settings_gap"
        android:stateListAnimator="@animator/focus_scale">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/browse"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/settings_text_body"
            android:fontFamily="@font/inter_medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/storeRemoveButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/settings_action_button_height"
        android:layout_marginStart="@dimen/settings_gap_s"
        android:background="@drawable/card_surface_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="@dimen/settings_gap"
        android:stateListAnimator="@animator/focus_scale">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/settings_text_caption"
            android:fontFamily="@font/inter_medium" />
    </LinearLayout>
</LinearLayout>
