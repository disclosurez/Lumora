<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/shelf_poster_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:background="@drawable/bg_grid_card"
    android:clickable="true"
    android:focusable="true"
    android:padding="8dp"
    android:stateListAnimator="@animator/focus_scale">

    <ImageView
        android:id="@+id/itemPoster"
        android:layout_width="match_parent"
        android:layout_height="@dimen/shelf_poster_image_height"
        android:background="@color/surface"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="@drawable/grad_poster_scrim" />

    <com.lumora.ui.OutlineTextView
        android:id="@+id/itemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="8dp"
        android:autoSizeMaxTextSize="@dimen/poster_title_text"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:lineSpacingExtra="1dp"
        android:maxLines="4"
        android:shadowColor="#B3000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/poster_title_text"
        app:outlineColor="@color/poster_title_outline"
        app:outlineWidth="@dimen/poster_title_outline_width" />
</FrameLayout>
