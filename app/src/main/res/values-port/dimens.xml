<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait phones only. Smallest-width outranks orientation in resource precedence, so a
     large device (tablet/TV, sw>=540dp) held in portrait still resolves values-sw540dp/ and
     never lands here - this file is effectively "phone, portrait". -->
<resources>
    <!-- Portrait phone screens are typically 360-430dp wide - the TV-sized 240dp sidebar
         plus a 144dp fixed guide column left near nothing for actual content, causing
         cutoff/overlap. Scale everything down to fit a phone-width screen. -->
    <!-- 140dp left ~80dp of text per row (star + row padding + margins eat 60 of it), which
         at 10sp is ~14 characters - most provider category names ellipsised to a prefix.
         The rail is hidden by default in portrait now (see isSidebarCollapsed), so the space
         it costs the content is only spent while the user is actually picking a category:
         widen it, tighten the row padding, and let a name wrap to a third line. -->
    <dimen name="category_sidebar_width">176dp</dimen>
    <dimen name="category_row_padding_horizontal">6dp</dimen>
    <integer name="category_row_max_lines">3</integer>
    <dimen name="live_preview_width">140dp</dimen>
    <dimen name="live_preview_height">79dp</dimen>
    <dimen name="guide_channel_column_width">150dp</dimen>

    <!-- Toolbar: 20dp of padding either side plus a labelled search button and two 48dp icon
         buttons left the title almost no room on a 360dp screen. The bar itself is
         wrap_content - these buttons are what set its height. -->
    <dimen name="toolbar_padding_horizontal">12dp</dimen>
    <dimen name="toolbar_button_size">42dp</dimen>
    <!-- Portrait-phone tab band: tab_padding_vertical 10dp x2 + 20dp icon + ~16dp label
         line (tab_text 12sp). Matches the unselected tab item height. -->
    <!-- Portrait phone: tight edge for the icon-only settings/refresh pair (see
         values/dimens.xml) - the 14dp tab padding would render them as empty capsules. -->
    <dimen name="chrome_button_padding_h">8dp</dimen>
    <!-- The merged chrome row gives the tab scroller a weight=3 window; on a 360dp screen
         every dp counts, so the decorative brand collapses from 40dp to 28dp. -->
    <dimen name="toolbar_brand_size">28dp</dimen>
    <!-- Portrait phone: toolbar_padding_horizontal is already 12dp - no pull needed
         (the icon is ~12dp from the edge), keep 0 so it doesn't go flush. -->
    <dimen name="toolbar_brand_translate_x">0dp</dimen>

    <!-- Tabs: 36dp of padding either side of five pills is far wider than a portrait phone.
         The row scrolls rather than clipping now, but tightening the pills means the first
         few are reachable without scrolling at all. -->
    <dimen name="tab_padding_horizontal">14dp</dimen>
    <dimen name="tab_padding_vertical">10dp</dimen>
    <dimen name="tab_text">12sp</dimen>

    <!-- With the sidebar taking 140dp of a 360dp screen, the 128dp default column width
         yields a single poster per row. A narrower minimum gets two. -->
    <dimen name="poster_grid_min_column_width">83dp</dimen>
    <dimen name="poster_image_height">99dp</dimen>

    <!-- Search overlay, portrait phones: the default 40dp phone-tier keys are under the
         48dp touch-target floor, and with the portrait layout stacking the keyboard
         full-width above the results (layout-port/dialog_search.xml) the keys are the
         primary input - bump them to a real thumb target. -->
    <dimen name="keyboard_key_height">48dp</dimen>
    <dimen name="keyboard_key_gap">4dp</dimen>
    <dimen name="keyboard_key_text">15sp</dimen>
    <dimen name="keyboard_action_text">12sp</dimen>
    <dimen name="catchup_category_column_width">150dp</dimen>
    <!-- Catch Up columns: channel list stays put while days/programmes fly out beside it. -->
    <dimen name="catchup_channel_column_width">160dp</dimen>
    <dimen name="catchup_day_column_width">110dp</dimen>
</resources>
