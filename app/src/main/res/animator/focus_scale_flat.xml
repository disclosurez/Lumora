<!-- Same scale-up as focus_scale.xml but without the translationZ lift - for static,
     fixed-order rows (tab bar, settings nav rail) that never have a RecyclerView-style
     sibling-overdraw problem. The elevation shadow from translationZ can leave a stale
     ghost sliver above a view after it unfocuses on weaker TV-stick GPUs, so views that
     don't need the Z-lift should avoid it entirely rather than pay that cost. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="160"
                android:valueTo="1.06"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="160"
                android:valueTo="1.06"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="160"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="160"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
