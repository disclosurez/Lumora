<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="160"
                android:valueTo="1.06"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="160"
                android:valueTo="1.06"
                android:valueType="floatType" />
            <!-- Neighboring RecyclerView items are added/drawn in adapter order regardless
                 of focus, so a scaled-up card can get overdrawn by the next sibling unless
                 it's lifted onto its own Z plane to force it above them. -->
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="160"
                android:valueTo="12"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="160"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="160"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="160"
                android:valueTo="0"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
