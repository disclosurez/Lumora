<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TV/landscape defaults - plenty of width to spare for a persistent sidebar + overlay preview. -->
    <dimen name="category_sidebar_width">190dp</dimen>
    <dimen name="live_preview_width">240dp</dimen>
    <dimen name="live_preview_height">126dp</dimen>
    <!-- Widened from 170dp for ~8 more characters of channel name. The name renders at
         guide_channel_name_text (9sp here) in Inter Medium, whose average advance is roughly
         0.6em for the upper-case/digit-heavy names providers actually ship - so 8 characters
         is about 43dp. Everything here comes straight off the programme grid to the right;
         the guide header's spacer in activity_main.xml reads the same dimen, so the time
         ruler stays aligned by itself. -->
    <dimen name="guide_channel_column_width">213dp</dimen>

    <!-- Settings/provider-setup type scale, at arm's-length (phone/tablet) reading distance.
         values-television/ steps the whole scale up for sofa distance - change both together
         so the relative hierarchy stays intact. -->
    <dimen name="settings_text_micro">8sp</dimen>
    <dimen name="settings_text_caption">10sp</dimen>
    <dimen name="settings_text_body">11sp</dimen>
    <dimen name="settings_text_subtitle">12sp</dimen>
    <dimen name="settings_text_section">14sp</dimen>
    <dimen name="settings_text_title">17sp</dimen>

    <dimen name="settings_nav_icon_size">26dp</dimen>
    <dimen name="settings_nav_rail_width">220dp</dimen>
    <dimen name="settings_type_card_height">46dp</dimen>
    <!-- Overrides the content pane's uniform 24dp padding on the end edge only, so it must
         restate that 24dp as the non-TV baseline rather than being a 0dp "no inset". -->
    <dimen name="settings_content_inset">24dp</dimen>

    <!-- Settings card rows are wrap_content in height with this above and below the label,
         so a row is exactly as tall as its text needs rather than a fixed 44/48dp box that
         stays the same size while the type scale around it changes. -->
    <dimen name="settings_row_padding_vertical">14dp</dimen>

    <!-- Settings spacing scale. These were literal dp values repeated ~80 times across
         activity_settings.xml, which meant the gaps between every label, field and card stayed
         at phone size on a TV while the type around them grew - the panes ended up far taller
         than the screen and every one of them scrolled. Routing them through tokens lets
         values-sw540dp/ pull the whole layout in without touching the layout file.

         The phone values are exactly the literals they replaced, so nothing moves on a phone. -->
    <dimen name="settings_gap_xs">4dp</dimen>
    <dimen name="settings_gap_s">6dp</dimen>
    <dimen name="settings_gap_m">10dp</dimen>
    <dimen name="settings_gap">12dp</dimen>
    <dimen name="settings_gap_ml">14dp</dimen>
    <dimen name="settings_gap_l">16dp</dimen>
    <dimen name="settings_gap_xl">20dp</dimen>
    <!-- Padding around the whole content pane, inside the ScrollView. -->
    <dimen name="settings_pane_padding">24dp</dimen>
    <!-- Small outline actions inside a row ("Change", "Test") - fixed height, unlike the
         wrap_content card rows, because they sit beside a label rather than holding one. -->
    <dimen name="settings_action_button_height">34dp</dimen>
    <dimen name="settings_qr_size">128dp</dimen>

    <!-- Episode list runs the full available width everywhere except TV, where a full-width
         row is far wider than the content in it. -->
    <dimen name="detail_list_end_inset">0dp</dimen>

    <!-- Live TV: category sidebar and the EPG guide grid. Same story as the settings scale -
         these were sized for a phone in the hand; values-television/ steps them up. -->
    <dimen name="category_row_text">10sp</dimen>
    <dimen name="category_row_padding_vertical">8dp</dimen>
    <dimen name="guide_channel_name_text">9sp</dimen>
    <dimen name="guide_channel_number_text">8sp</dimen>
    <dimen name="guide_channel_initial_text">9sp</dimen>
    <dimen name="guide_program_text">11sp</dimen>
    <dimen name="guide_channel_logo_size">26dp</dimen>
    <!-- Floor only - the row is wrap_content and normally taller than this on its own. -->
    <dimen name="guide_row_min_height">34dp</dimen>
    <dimen name="category_row_padding_horizontal">10dp</dimen>
    <!-- How far a long category name may wrap before it ellipsises. Portrait phones get a
         third line (values-port) - the rail is narrowest exactly where names are longest. -->
    <integer name="category_row_max_lines">2</integer>

    <!-- Toolbar / tab bar / poster grid. Padding shrinks on TV as the type grows: the tabs
         are a fixed-width row of five, so 36dp of padding either side of much larger labels
         would push the row past the panel. -->
    <!-- Toolbar: app name is +30% over the old text_subhead it borrowed, the search label
         and the three icons +20%. Each has its own token now rather than sharing a step of
         the general type scale, so the toolbar can be tuned without moving everything else
         that happened to sit on the same step. -->
    <dimen name="tab_text">13sp</dimen>
    <!-- Toolbar clock: a deliberate step under tab_text - it's ambient information, not a
         control, so it must not compete with the tab labels for the eye. -->
    <dimen name="toolbar_clock_text">11sp</dimen>
    <dimen name="tab_padding_horizontal">36dp</dimen>
    <!-- Tab pills are wrap_content in height with this above and below the label, and the
         tab bar itself is wrap_content around them - so the row's height is a function of
         tab_text, not a fixed bar the labels happen to sit inside. -->
    <dimen name="tab_padding_vertical">12dp</dimen>
    <!-- Extra gap before the first (Live TV) tab, TV tier only (see values-sw540dp) - zero
         here, the brand's own translationX already sets the phone spacing. -->
    <dimen name="tab_live_start_gap">0dp</dimen>
    <!-- Compact ("stacked") pill metrics, applied by applyChromeWrap() on portrait phones
         only - never resolved by a layout, so they carry no orientation qualifier: the
         Activity handles configChanges itself and never re-inflates, which would leave any
         values-port copy of these stale after a rotate. Icon over label instead of beside it
         roughly halves a pill's width, which is what gets the nine chrome items onto two
         wrapped lines in a ~260dp window instead of three. -->
    <dimen name="tab_text_compact">11sp</dimen>
    <dimen name="tab_padding_compact_horizontal">6dp</dimen>
    <dimen name="tab_padding_compact_vertical">6dp</dimen>
    <dimen name="tab_label_compact_gap">2dp</dimen>
    <dimen name="tab_label_gap">8dp</dimen>
    <dimen name="poster_title_text">10sp</dimen>
    <!-- Floor for the auto-sized poster/EPG titles. A hard 8sp meant any title that wrapped
         to three or four lines shrank to unreadable at TV viewing distance; keeping the floor
         close to the ceiling costs an ellipsis on the longest titles instead. -->
    <dimen name="poster_title_text_min">9sp</dimen>
    <dimen name="poster_title_outline_width">0.7dp</dimen>
    <dimen name="poster_badge_text">8sp</dimen>
    <dimen name="poster_image_height">110dp</dimen>
    <!-- Horizontal shelf rows (Home/Series/Films). These were hardcoded in
         item_shelf_poster.xml, so unlike the grid they never scaled by device class - a TV
         got the same 108dp card as a phone and fitted six of them across the row. Artwork
         is 2:3, so the image height is (width - 16dp of card padding) x 1.5. -->
    <dimen name="shelf_poster_width">86dp</dimen>
    <dimen name="shelf_poster_image_height">110dp</dimen>
    <!-- General on-screen body copy outside the settings scale (empty states, Up Next). -->
    <dimen name="content_body_text">13sp</dimen>

    <!-- Shelf row header (Series/Films category name, Home shelf titles) and its See All
         action. Both were on the shared type scale at its two smallest steps, which made
         the category name no bigger than a poster caption and See All the smallest text on
         the screen - the header is what tells you which row you are looking at. -->
    <dimen name="shelf_title_text">15sp</dimen>
    <dimen name="shelf_action_text">13sp</dimen>
    <!-- See All is the only header control with a word in it (the pin/hide ones are single
         glyphs), and it was the smallest hit target on the screen - hard to aim at on a
         phone and easy to skip past with a remote. Padding and a minimum height are pulled
         out here so the large-screen tier can grow it without touching the layout.

         Tightened from 18/11dp padding and a 44dp floor: the button read oversized with the
         ALL-CAPS label floating in it. The label is ~16dp tall at 13sp, so 6dp vertical
         padding + a 32dp floor keeps a usable touch target while the pill hugs the text. -->
    <dimen name="shelf_action_padding_h">12dp</dimen>
    <dimen name="shelf_action_padding_v">6dp</dimen>
    <dimen name="shelf_action_min_height">32dp</dimen>

    <!-- App-wide type scale. Every layout's text size resolves through one of these rather
         than a literal sp value, so a device-class change is one edit per step instead of a
         hunt through 60-odd layouts. These are the phone values; values-sw540dp/ carries the
         large-screen (TV/tablet) tier.

         Steps are named for their role, and the numbers are the sizes that were already
         hardcoded across the layouts - this introduces no visual change on phones. -->
    <dimen name="text_tiny">9sp</dimen>
    <dimen name="text_caption">10sp</dimen>
    <!-- Player side menu drawer width - shared by the layout and the slide-in/out
         animation so the panel always lands exactly one panel-width off-screen. -->
    <dimen name="player_side_menu_width">228dp</dimen>
    <!-- The category column that flies out to the right of the nav rows. Shared by the
         layout and the expand/collapse width animation. -->
    <dimen name="player_side_menu_category_width">248dp</dimen>
    <!-- Side-menu row metrics, deliberately NOT the browse sidebar's (category_row_*/
         tab_text): this panel is an overlay on top of playing video on a 960dp-wide TV, so
         both columns together have to stay near half the screen and every section has to
         fit without scrolling. Sized once here rather than per-bucket - dp/sp already
         normalise across the phone and TV densities this panel runs at. -->
    <dimen name="side_menu_row_height">38dp</dimen>
    <dimen name="side_menu_text">13sp</dimen>
    <dimen name="side_menu_icon">17dp</dimen>
    <dimen name="text_body_s">11sp</dimen>
    <dimen name="text_body">12sp</dimen>
    <dimen name="text_body_l">13sp</dimen>
    <dimen name="text_subhead">14sp</dimen>
    <dimen name="text_subhead_l">15sp</dimen>
    <dimen name="text_title_s">16sp</dimen>
    <dimen name="text_title">18sp</dimen>
    <dimen name="text_display">24sp</dimen>
    <dimen name="text_hero">48sp</dimen>

    <!-- Square icon buttons in the toolbar (settings/refresh/back). These are the tallest
         thing in the toolbar, so they set its (wrap_content) height. 48dp here is the
         minimum comfortable touch target on a phone. -->
    <dimen name="toolbar_button_size">48dp</dimen>
    <!-- Height of the chrome-row cluster buttons (search/settings/refresh). Sized to the
         tab ITEM's height - the tabs are icon+label blocks whose wrap height is their
         vertical padding plus the icon plus the label line, so this tracks the tab band
         per tier (see the sw540dp and values-port overrides). The search pill used
         match_parent, which overshot to the whole scroller height and read as oversized
         next to the tabs. -->
    <!-- The brand mark in the chrome row. Was a 40dp literal; now a dimen so portrait
         phones (values-port) can collapse it and give the tab scroller more width. -->
    <dimen name="toolbar_brand_size">40dp</dimen>
    <!-- Post-layout leftward shift for the brand icon so it sits ~14dp from the screen
         edge instead of behind the row's full toolbar_padding_horizontal. Negative per
         tier (padding minus the 14dp target): base padding 20dp -> -6dp. translationX
         moves only the icon - the tabs keep their laid-out position. -->
    <dimen name="toolbar_brand_translate_x">-6dp</dimen>
    <!-- Post-layout vertical nudge for the brand icon, TV tier only (see values-sw540dp) -
         zero here since the phone brand already sits flush against the row's top edge. -->
    <dimen name="toolbar_brand_translate_y">0dp</dimen>
    <dimen name="toolbar_padding_horizontal">20dp</dimen>
    <!-- Gap between the three toolbar cluster buttons (search/settings/refresh) and the air
         after the last one. Was a 4dp literal on settings/refresh with nothing on the right;
         the search pill's own 14dp padding made the cluster read as one wide gap then two
         pinched ones. The search pill now carries toolbar_search_padding_horizontal instead,
         so the spaces between and after the buttons share one rhythm. -->
    <dimen name="toolbar_button_gap">6dp</dimen>
    <!-- Breathing room between the tab scroller and the settings/refresh cluster: the
         search pill used to touch the last tab (Discover) with zero gap, which read as an
         overlap on TV. Dedicated dimen rather than toolbar_button_gap because that gap is
         for between-buttons spacing; this one separates a scrollable region from the
         fixed cluster and needs to be wider. 20dp (up from 12dp): the settings pill read
         as crowding the Search tab even with the 12dp gap plus its own 8dp margin, and
         either pill's 1.06x focus scale eats into it further. -->
    <dimen name="chrome_cluster_gap">20dp</dimen>
    <!-- Horizontal padding of the chrome-row icon buttons (settings/refresh). Deliberately
         NOT tab_padding_horizontal: that metric pads a pill that holds icon+label, and
         applied to a bare icon it rendered wide empty capsules (a 51dp-tall TV button was
         56dp wide around a 20dp icon). This is a tight symmetric edge so the pair reads
         as compact icon buttons - the tab-band height and focus ring carry the tab
         language instead. -->
    <dimen name="chrome_button_padding_h">10dp</dimen>

    <!-- Minimum width one poster column may occupy; the grid fits as many as will go (then
         clamps to poster_grid_max_span). Portrait phones use a smaller value so a narrow
         screen still gets two columns rather than one. -->
    <dimen name="poster_grid_min_column_width">102dp</dimen>

    <!-- Search overlay. A width of 0dp is the sentinel for "fill the slot" - a dimen can't
         hold match_parent, so showSearchDialog() applies any non-zero value as an explicit
         width and leaves the layout's match_parent alone otherwise. A phone has no width to
         give away; values-sw540dp/ pins it to a centred panel. -->
    <dimen name="search_panel_width">0dp</dimen>
    <dimen name="search_panel_padding">16dp</dimen>
    <dimen name="search_keyboard_width">240dp</dimen>
    <dimen name="keyboard_key_height">40dp</dimen>
    <dimen name="keyboard_key_gap">3dp</dimen>
    <dimen name="keyboard_key_text">15sp</dimen>
    <dimen name="keyboard_action_text">11sp</dimen>
    <!-- Vertical gap between the search header (icon + query field + close) and the
         keyboard/results row below it. Was a 14dp literal in the layout. -->
    <dimen name="search_section_gap">14dp</dimen>
    <!-- Gutter between the keyboard column and the results column. Was a 12dp literal. -->
    <dimen name="search_column_gap">12dp</dimen>
    <!-- Shorter than poster_image_height: a search column is much narrower than a Films/Series
         grid column, and the card's height doesn't follow its width, so the full-size value
         stretched the artwork well past the 2:3 it's cropped to. -->
    <dimen name="search_poster_image_height">96dp</dimen>
    <!-- Vertical gap between the search status line, recents strip, filter chips and the
         results grid, and horizontal gap between the filter chips. -->
    <dimen name="search_row_gap">8dp</dimen>
    <dimen name="search_chip_gap">8dp</dimen>

    <!-- Search bar at the top of Home. Same 0dp = fill sentinel. -->
    <dimen name="home_search_bar_width">0dp</dimen>
    <dimen name="catchup_category_column_width">240dp</dimen>
    <!-- Catch Up columns: channel list stays put while days/programmes fly out beside it. -->
    <dimen name="catchup_channel_column_width">260dp</dimen>
    <dimen name="catchup_day_column_width">150dp</dimen>
</resources>
