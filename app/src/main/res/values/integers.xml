<resources>
    <!-- Upper bound on poster-grid columns. The span is normally derived from the grid's
         measured width, which on a wide panel yields more, narrower columns than reads well -
         values-television/ caps it lower so cards stay large enough to see across a room. -->
    <integer name="poster_grid_max_span">8</integer>

    <!-- Columns in the search results grid. Fixed rather than derived from width: the grid
         now shares the panel with the on-screen keyboard, so screen width no longer
         describes the space it actually has. -->
    <integer name="search_results_span">2</integer>
    <integer name="catchup_max_columns">3</integer>
</resources>
