<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Cast -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android Auto (auto/LumoraCarAppService.kt). A template permission + ACCESS_SURFACE are
         what the Car App Library requires to draw a template and be handed its drawing
         surface - the surface the player renders video into, there being no video app category
         on Android Auto. Both template permissions are declared because which one a host
         honours depends on its version: MAP_TEMPLATES arrived with car-app 1.4 and is what
         current hosts check, while an older host only recognises NAVIGATION_TEMPLATES and
         hands a surface to nothing that lacks it. CAR_SPEED backs the parked-only gate; it is
         optional at runtime, and the gate falls back to the user's setting when the host
         won't report. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />


    <!-- Self-update: AppUpdateInstaller hands the downloaded APK to the system installer
         via ACTION_VIEW. Without this permission the install is refused outright; without
         the <queries> declaration below, targetSdk 36's package-visibility rules mean the
         implicit ACTION_VIEW intent can't even resolve the installer activity, so
         startActivity() silently finds nothing to launch. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <!-- External playback (player/ExternalPlayer.kt): without this, package visibility on
             API 30+ hides every installed video player, so the resolve comes back empty and
             the app would report "no player installed" on a device with VLC on it. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.pro" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.brouken.player" />
        <package android:name="is.xyz.mpv" />
    </queries>

    <!-- largeHeap: merged catalogues run to six figures of Channel objects across several
         providers, all resident so browsing and search stay instant. A TV stick's default heap
         caps around 170MB, which one large Stalker portal was enough on its own to exhaust. -->
    <application
        android:name=".BaseApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@mipmap/banner_tv"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:appCategory="game"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumora"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
            <!-- Android TV's launcher, in its own filter so the car-facing one above stays
                 identical to a known-listed car app's. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- APK downloaded by AppUpdateInstaller lives in public Downloads; this is what
             lets the system package installer read it via a content:// URI on API 24+
             instead of a raw file:// path, which is blocked since Android N. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Reminder receivers -->
        <receiver android:name=".reminder.ReminderAlarmReceiver" android:exported="false" />
        <receiver android:name=".reminder.ReminderBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Its code branches on MY_PACKAGE_REPLACED; unregistered, app updates never
                     re-armed reminders. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Recording receivers -->
        <receiver android:name=".recording.RecordingAlarmReceiver" android:exported="false" />
        <receiver android:name=".recording.RecordingRestoreReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Foreground-notification holder for TorrentEngine streams (see com.lumora.torrent). -->
        <service
            android:name=".torrent.TorrentForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- No MediaBrowserService is declared, and no class implements one. Advertising one
             is what made Android Auto file Lumora as a media app - listed, but audio-only,
             with the car service never bound. The undeclared implementation that used to sit
             in auto/ was unreachable code and is gone; a future Assistant/Wear integration
             would need its own service anyway. -->

        <!-- Android Auto. minCarApiLevel and the service below are the entire car
             registration - deliberately no com.google.android.gms.car.application descriptor,
             which is how a *media* app announces itself and got Lumora listed as audio-only.
             Both POI and NAVIGATION are declared because a host launches only the categories
             its version knows: current hosts list a sideloaded POI app, while an older one
             (Android Auto 14 and before) shows no launcher tile for POI at all and lists only
             navigation apps. Either category is handed the same drawing surface, which is all
             the video path needs (see auto/CarPlayerScreen.kt). -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- Required, not optional: CAR.VALIDATOR denies any package that declares a
             CarAppService without a descriptor naming the template surface, and a denied
             package never reaches the car launcher. The descriptor names template and
             notification, never media - media is the entry that made Lumora audio-only. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- The template car app (auto/LumoraCarAppService.kt) is deliberately NOT declared.
             Android Auto treats a template CarAppService and a projected Activity as mutually
             exclusive, and prefers the template one:

               GH.AvailableAppFinder: Skipping ProjectionApp(ComponentInfo{com.lumora/
               com.lumora.MainActivity}, appCategory=OTHER, isParkedOnly=true,
               isImmersiveApp=true, isNativeApp=true) due to a conflicting driving optimized app

             Declaring the service therefore replaces the whole app with a six-row list and a
             bare video surface. Leaving it out lets the host project MainActivity itself -
             the real UI, parked only - which is the point of running Lumora in a car at all.
             The classes under auto/ are kept for the day a driving-optimised mode is wanted
             back; nothing binds them while this declaration is absent. -->

        <!-- No TV Input Framework service. Lumora advertised one, but nothing ever wrote a
             row into TvContract.Channels, so the system input selector had an empty Lumora
             input that could never be tuned - and the session's tune lookup read the Room
             `channels` table, which only the (equally unscheduled) catalog sync worker ever
             filled. Both sides were stubs, so the input is gone rather than left advertising
             a source that cannot play. -->

        <!-- Cast -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.lumora.player.CastOptionsProvider" />

        <!-- WorkManager initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
